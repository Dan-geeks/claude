#!/usr/bin/env bash
# claude-link [status|claude|chatgpt] - link your own Claude and ChatGPT plans.
#
#   claude-link status    show which plans are linked
#   claude-link claude    sign in with your Claude subscription
#   claude-link chatgpt   sign in with your ChatGPT (Plus/Pro/Team) account, used when
#                         Claude is rate limited or in `claude-switch codex` mode
#
# Each person links their OWN accounts. Logins stay on this machine.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
real="${CLAUDE_REAL:-}"
if [ -z "$real" ]; then
  while IFS= read -r candidate; do
    [ "$(readlink -f "$candidate")" = "$self" ] && continue
    real="$candidate"
    break
  done < <(type -ap claude)
fi
codex_home="${CODEX_HOME:-$HOME/.codex}"

chatgpt_linked() {
  [ -f "$codex_home/auth.json" ] && python3 -I -c '
import json,sys
d=json.load(open(sys.argv[1]))
t=d.get("tokens") or {}
sys.exit(0 if d.get("auth_mode")=="chatgpt" and t.get("access_token") and t.get("refresh_token") else 1)
' "$codex_home/auth.json" 2>/dev/null
}

status() {
  echo "Claude subscription:"
  if [ -n "$real" ] && "$real" auth status >/dev/null 2>&1; then echo "  linked"; else echo "  NOT linked   -> claude-link claude"; fi
  echo "ChatGPT account:"
  if chatgpt_linked; then echo "  linked"; else echo "  NOT linked   -> claude-link chatgpt  (needed for failover and codex mode)"; fi
}

case "${1:-status}" in
  status) status ;;
  claude)
    [ -n "$real" ] || { echo "claude-link: Claude Code is not installed" >&2; exit 1; }
    "$real" auth login
    status
    ;;
  chatgpt)
    command -v codex >/dev/null || { echo "claude-link: install the Codex CLI first (npm i -g @openai/codex)" >&2; exit 1; }
    # The proxy reads the login from ~/.codex/auth.json, so ask Codex to keep it in a file
    # instead of the OS keyring.
    codex login -c 'cli_auth_credentials_store="file"'
    if chatgpt_linked; then echo "ChatGPT account linked."; else
      echo "claude-link: login finished but $codex_home/auth.json has no ChatGPT login." >&2
      echo "  Set cli_auth_credentials_store = \"file\" in $codex_home/config.toml and run this again." >&2
      exit 1
    fi
    ;;
  *) echo "usage: claude-link [status|claude|chatgpt]" >&2; exit 2 ;;
esac
